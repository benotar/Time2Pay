users [icon: user, color: blue] {
  id uuid pk
  display_name text
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

employments [icon: briefcase, color: blue] {
  id uuid pk
  user_id uuid
  name text
  description text
  start_date date
  end_date date
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

compensation_rates [icon: dollar-sign, color: green] {
  id uuid pk
  employment_id uuid
  rate_type text
  amount numeric(12,2)
  currency char(3)
  valid_from_date date
  valid_to_date date
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

work_days [icon: sun, color: purple] {
  id uuid pk
  employment_id uuid
  date date
  day_type text
  started_at time
  ended_at time
  duration_minutes int
  break_minutes int
  comment text
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

payments [icon: credit-card, color: green] {
  id uuid pk
  employment_id uuid
  paid_date date
  amount numeric(12,2)
  currency char(3)
  payment_method text
  period_start_date date
  period_end_date date
  comment text
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

exchange_rates [icon: trending-up, color: green] {
  month date pk
  rate numeric(10,4)
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

exchange_rate_caps [icon: shield, color: green] {
  id uuid pk
  rate numeric(10,4)
  valid_from date
  valid_to date
  created_at_utc timestamptz
  last_modified_at_utc timestamptz
}

calendar [icon: grid, color: gray] {
  date date pk
  year int
  half_year int
  quarter int
  month int
  iso_year int
  iso_week int
  iso_weekday int
  is_weekend boolean
  is_public_holiday boolean
}

employments.user_id > users.id
compensation_rates.employment_id > employments.id
work_days.employment_id > employments.id
payments.employment_id > employments.id
work_days.date > calendar.date
